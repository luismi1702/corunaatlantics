# Carpetas de trabajo de herramientas, no del proyecto
.impeccable/
.playwright-mcp/
.superpowers/brainstorm/

# Capturas sueltas de Windows
{*}.png
vapid.txt

# Material de trabajo, no del proyecto. Pesan mucho y no los usa la web: los
# .psd son las fuentes de edicion de los logos y los videos en bruto salen del
# movil. Lo que si va versionado es el resultado —los .png, los .webp— y los
# guiones de videos/.
*.psd
*.mp4

# Menos estos dos: son el fondo de la web, no material de trabajo. Sin esta
# excepcion, el dia que alguien los vuelva a añadir git los ignoraria y la
# portada se quedaria sin fondo sin que nadie entienda por que.
!storm.mp4
!waves.mp4

# Cache de Python (playbook/generar.py y demas scripts)
__pycache__/
docs/nerion/

# Documentos de identidad de los jugadores para las licencias. Nunca a GitHub.
fefapa/

# Cuentas del club con nombres e importes. El repo es publico y la web sirve docs/.
docs/privado/

# Fuera de git segun CLAUDE.md: hojas de entreno y material de redes (pesa ~360 MB).
entrenos/
redes/

# Tipografias de terceros: su licencia puede no permitir redistribuirlas en un repo publico.
equipacion/fuentes/
